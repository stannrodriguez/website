---
import "../styles/global.css";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site } from "../data/site";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  /** For pages like 404 that shouldn't be indexed or have a canonical URL. */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
// Pages build as directories, so canonical URLs always end in a slash.
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, Astro.site);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-s);
    top: -100px;
    padding: var(--space-xs) var(--space-s);
    background: var(--ink);
    color: var(--paper);
  }

  .skip-link:focus {
    top: var(--space-s);
  }

  main {
    width: 100%;
    max-width: calc(var(--measure) + 2 * var(--space-m));
    margin-inline: auto;
    padding: var(--space-xl) var(--space-m);
  }

  main:focus {
    outline: none;
  }
</style>
