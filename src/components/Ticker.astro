---
/**
 * A slow, looping line of words. The list is rendered twice so the loop is
 * seamless; the copy is hidden from assistive tech. Pauses on hover, and
 * stands still (wrapping instead) when reduced motion is requested.
 */
interface Props {
  label: string;
  items: string[];
}

const { label, items } = Astro.props;
---

<div class="ticker">
  <span class="label eyebrow">{label}</span>
  <div class="viewport">
    <div class="track">
      <ul role="list">{items.map((item) => <li>{item}</li>)}</ul>
      <ul role="list" aria-hidden="true">{items.map((item) => <li>{item}</li>)}</ul>
    </div>
  </div>
</div>

<style>
  .ticker {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding-block: var(--space-s);
    border-block: 1.5px solid var(--ink);
  }

  .label {
    flex: none;
    color: var(--ink);
  }

  .viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
  }

  ul {
    display: flex;
    flex: none;
    padding: 0;
    list-style: none;
    font-size: var(--step-1);
    font-style: italic;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    white-space: nowrap;
  }

  li::after {
    content: "✶";
    display: inline-block;
    margin-inline: 0.8em;
    color: var(--accent);
    font-style: normal;
    font-size: 0.7em;
    vertical-align: 0.15em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: scroll 60s linear infinite;
    }

    .ticker:hover .track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    ul:first-child {
      flex: 1 1 auto;
      flex-wrap: wrap;
      width: auto;
      white-space: normal;
    }

    ul[aria-hidden] {
      display: none;
    }
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
