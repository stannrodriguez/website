---
import { formatDate, type Note } from "../lib/notes";
import { withBase } from "../lib/url";

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
---

{
  notes.length === 0 ? (
    <p class="meta">Nothing published yet.</p>
  ) : (
    <ul class="notes" role="list">
      {notes.map((note) => (
        <li>
          <time class="meta" datetime={note.data.date.toISOString()}>
            {formatDate(note.data.date)}
          </time>
          <div>
            <a class="note-title" href={withBase(`notes/${note.id}/`)}>
              {note.data.title}
            </a>
            {note.data.todo && (
              <>
                {" "}
                <span class="todo">TODO</span>
              </>
            )}
            {note.data.draft && <span class="meta"> (draft)</span>}
            <p class="note-description">{note.data.description}</p>
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  .notes {
    display: grid;
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: var(--space-2xs) var(--space-m);
  }

  @media (min-width: 34rem) {
    li {
      grid-template-columns: 7rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .note-title {
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }

  .note-title:hover {
    text-decoration: underline;
  }

  .note-description {
    color: var(--ink-muted);
  }
</style>
