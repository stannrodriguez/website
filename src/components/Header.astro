---
import { nav, site } from "../data/site";
import { withBase } from "../lib/url";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <a class="wordmark" href={withBase()}>{site.name}</a>
  <nav aria-label="Primary">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={`${withBase()}#${item.hash}`}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ThemeToggle />
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
    max-width: var(--page);
    margin-inline: auto;
    padding: var(--space-m) var(--space-m) 0;
  }

  .wordmark {
    margin-right: auto;
    font-weight: 600;
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
  }

  @media (max-width: 34rem) {
    nav {
      order: 3;
      width: 100%;
    }
  }
</style>
