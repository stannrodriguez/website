---
import { nav, site } from "../data/site";
import { withBase } from "../lib/url";

const here = Astro.url.pathname.replace(/\/?$/, "/");
const isCurrent = (path: string) => {
  const target = withBase(path);
  return path === "" ? here === target : here.startsWith(target);
};
---

<header class="site-header">
  <a class="name" href={withBase()}>{site.name}</a>
  <nav aria-label="Primary">
    <ul role="list">
      {
        nav.map((item) => (
          <li>
            <a href={withBase(item.path)} aria-current={isCurrent(item.path) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-m);
    width: 100%;
    max-width: calc(var(--measure) + 2 * var(--space-m));
    margin-inline: auto;
    padding: var(--space-xl) var(--space-m) 0;
  }

  @media (min-width: 560px) {
    .site-header {
      padding-top: var(--space-2xl);
    }
  }

  .name {
    margin-right: auto;
    font-family: var(--font-sans);
    font-size: var(--step-3);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.15;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: var(--space-s);
  }

  nav a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }
</style>
