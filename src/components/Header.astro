---
import { nav, site } from "../data/site";
import { withBase } from "../lib/url";
import Glyph from "./Glyph.astro";
import ThemeToggle from "./ThemeToggle.astro";

// Highlight the section you're in: notes pages count as "Notes".
const here = Astro.url.pathname.replace(/\/?$/, "/");
const isCurrent = (path: string) => {
  const target = withBase(path);
  return path === "" ? here === target : here.startsWith(target);
};
---

<header class="site-header">
  <a class="wordmark kind-play" href={withBase()}>
    <Glyph slug="stephanie" kind="play" size={26} />
    <span>{site.name}</span>
  </a>
  <nav aria-label="Primary">
    <ul role="list">
      {
        nav.map((item) => (
          <li>
            <a href={withBase(item.path)} aria-current={isCurrent(item.path) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ThemeToggle />
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
    width: 100%;
    max-width: var(--page);
    margin-inline: auto;
    padding: var(--space-m) var(--space-m) 0;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    margin-right: auto;
    font-weight: 620;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .wordmark:hover {
    color: inherit;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wordmark :global(.glyph) {
      transition: rotate 700ms var(--ease-spring);
    }

    .wordmark:hover :global(.glyph) {
      rotate: 0.5turn;
    }
  }

  ul {
    display: flex;
    gap: var(--space-2xs);
    padding: 0.25rem;
    border: 1.5px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-raised);
    list-style: none;
  }

  nav a {
    display: block;
    padding: 0.3em 0.85em;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-decoration: none;
    transition:
      background-color 160ms,
      color 160ms;
  }

  nav a:hover {
    color: var(--ink);
    background: color-mix(in oklch, var(--ink) 7%, transparent);
  }

  nav a[aria-current="page"] {
    background: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 34rem) {
    nav {
      order: 3;
      width: 100%;
    }
  }
</style>
