---
/**
 * A large card for the featured work at the top of the home page: hook,
 * highlights, a row of metrics, and, where there is any, a press strip. The
 * corners carry printer's registration marks, which turn when you hover the
 * card. Each card takes its color from its own hue.
 */
import type { Featured } from "../data/featured";
import Glyph from "./Glyph.astro";

interface Props {
  item: Featured;
  /** 1-based position; shown as the specimen number. */
  number: number;
}

/** Highlights past this many fold into a "More" disclosure. */
const SHOWN = 4;

const { item: f, number } = Astro.props;
const href = f.links[0]?.href;
const no = String(number).padStart(2, "0");
const shown = f.bullets.slice(0, SHOWN);
const more = f.bullets.slice(SHOWN);
const hasPress = (f.press?.length ?? 0) > 0 || f.social;
---

<li class="featured-card kind-featured" style={`--i: ${number}; --h: ${f.hue}`}>
  <span class="mark tl" aria-hidden="true"></span>
  <span class="mark tr" aria-hidden="true"></span>
  <span class="mark bl" aria-hidden="true"></span>
  <span class="mark br" aria-hidden="true"></span>

  <article aria-labelledby={`${f.slug}-featured`}>
    <div class="top meta">
      <span>No. {no}</span>
      <span class="org"><span class="dot" aria-hidden="true"></span>{f.org}</span>
    </div>

    <div class="main">
      <div class="head">
        <Glyph slug={f.slug} kind={f.glyph} size={64} />
        <div>
          <h3 id={`${f.slug}-featured`} class="title">
            {href ? <a class="card-link" href={href}>{f.title}</a> : f.title}
          </h3>
          <p class="role meta">{f.role}</p>
        </div>
      </div>

      <p class="hook">{f.hook}</p>

      <ul class="bullets" role="list">
        {shown.map((b) => <li>{b}</li>)}
      </ul>
      {
        more.length > 0 && (
          <details class="more">
            <summary class="meta">{more.length} more</summary>
            <ul class="bullets" role="list">
              {more.map((b) => <li>{b}</li>)}
            </ul>
          </details>
        )
      }
    </div>

    {
      (f.metrics.length > 0 || f.flag) && (
        <div class="side">
          {f.flag && (
            <p class="flag meta">
              <span class="pulse" aria-hidden="true" />
              {f.flag}
            </p>
          )}
          {f.metrics.length > 0 && (
            <dl class="metrics">
              {f.metrics.map((m) => (
                <div>
                  <dt>{m.label}</dt>
                  <dd>{m.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      )
    }

    {
      hasPress && (
        <div class="press">
          <p class="eyebrow">In the press</p>
          <div class="press-grid">
            {f.press?.map((p) => (
              <figure class="quote">
                <blockquote cite={p.href}>
                  <p>“{p.quote}”</p>
                </blockquote>
                <figcaption class="meta">
                  <a href={p.href}>{p.source}</a>
                  {p.date && <> · {p.date}</>}
                  <span class="credit">{p.credit}</span>
                </figcaption>
              </figure>
            ))}
            {f.social && (
              <figure class="quote social">
                <blockquote cite={f.social.href}>
                  <p>“{f.social.caption}”</p>
                </blockquote>
                <dl class="stats meta">
                  {f.social.stats.map((s) => (
                    <div>
                      <dt>{s.label}</dt>
                      <dd>{s.value}</dd>
                    </div>
                  ))}
                </dl>
                {f.social.note && <p class="note">{f.social.note}</p>}
                <figcaption class="meta">
                  <a href={f.social.href}>
                    {f.social.source} by {f.social.handle}
                  </a>
                </figcaption>
              </figure>
            )}
          </div>
        </div>
      )
    }

    <div class="foot">
      {f.stack && <p class="stack meta">{f.stack.join(" · ")}</p>}
      <p class="links meta">
        {
          f.links.map((l) => (
            <a href={l.href}>
              {l.label}
              <span aria-hidden="true"> ↗</span>
            </a>
          ))
        }
      </p>
    </div>
  </article>
</li>

<style>
  .featured-card {
    position: relative;
    list-style: none;
  }

  /* Registration marks: a small crosshair centered on each corner. */
  .mark {
    position: absolute;
    z-index: 1;
    width: 22px;
    height: 22px;
    margin: -11px;
    background:
      linear-gradient(var(--rule-strong), var(--rule-strong)) center / 100% 1px no-repeat,
      linear-gradient(var(--rule-strong), var(--rule-strong)) center / 1px 100% no-repeat;
    pointer-events: none;
    transition:
      rotate 600ms var(--ease-spring),
      opacity 200ms;
  }

  .tl { top: 0; left: 0; }
  .tr { top: 0; right: 0; }
  .bl { bottom: 0; left: 0; }
  .br { bottom: 0; right: 0; }

  .featured-card:hover .mark,
  .featured-card:focus-within .mark {
    --rule-strong: var(--k);
    rotate: 45deg;
  }

  /* One column on phones; on wide screens the metrics sit beside the text. */
  article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "top"
      "main"
      "side"
      "press"
      "foot";
    gap: var(--space-m);
    height: 100%;
    padding: var(--space-m);
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    transition: border-color 200ms;
  }

  @media (min-width: 52rem) {
    article {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
      grid-template-areas:
        "top top"
        "main side"
        "press press"
        "foot foot";
      column-gap: var(--space-l);
      padding: var(--space-l);
    }
  }

  .featured-card:hover article,
  .featured-card:focus-within article {
    border-color: color-mix(in oklch, var(--k) 45%, var(--rule));
  }

  @media (prefers-reduced-motion: no-preference) {
    .featured-card {
      animation: rise 700ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 70ms + 200ms);
    }

    .featured-card:hover :global(.glyph),
    .featured-card:focus-within :global(.glyph) {
      animation: spin 9s linear infinite;
    }

    .pulse {
      animation: pulse 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }

  @keyframes pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in oklch, var(--k) 55%, transparent);
    }
    to {
      box-shadow: 0 0 0 0.6em transparent;
    }
  }

  .top {
    grid-area: top;
    display: flex;
    justify-content: space-between;
    gap: var(--space-xs);
    font-size: var(--step--2);
  }

  .org {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--k);
  }

  .dot,
  .pulse {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--k);
  }

  .main {
    grid-area: main;
    display: grid;
    align-content: start;
    gap: var(--space-s);
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .title {
    font-size: var(--step-2);
    font-weight: 560;
    font-variation-settings: "SOFT" 100, "WONK" 1;
  }

  .role {
    margin-top: var(--space-2xs);
    font-size: var(--step--2);
  }

  .card-link {
    text-decoration: none;
  }

  /* The whole card is the title link; every other link sits above it. */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .card-link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .card-link:hover {
    color: inherit;
  }

  .hook {
    max-width: 34em;
    font-size: var(--step-1);
    font-variation-settings: "SOFT" 100;
    line-height: 1.4;
  }

  .bullets {
    display: grid;
    gap: var(--space-xs);
    max-width: 38em;
    padding: 0;
    color: color-mix(in oklch, var(--ink) 85%, var(--paper));
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .bullets li {
    position: relative;
    padding-left: 1.25em;
    list-style: none;
  }

  .bullets li::before {
    content: "";
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 0.6em;
    height: 1px;
    background: var(--k);
  }

  .more {
    position: relative;
    z-index: 2;
  }

  .more summary {
    width: fit-content;
    font-size: var(--step--2);
    cursor: pointer;
  }

  .more summary:hover {
    color: var(--k);
  }

  .more .bullets {
    margin-top: var(--space-xs);
  }

  .side {
    grid-area: side;
    display: grid;
    align-content: start;
    gap: var(--space-s);
  }

  .flag {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    width: fit-content;
    padding: 0.3em 0.8em;
    border: 1px solid color-mix(in oklch, var(--k) 40%, var(--rule));
    border-radius: 999px;
    background: var(--wash);
    color: var(--k);
    font-size: var(--step--2);
  }

  /* Metrics: hairline-ruled cells, big number over a small label. */
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    border-top: 1px solid var(--ink);
  }

  .metrics > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: start;
    gap: var(--space-2xs);
    padding: var(--space-s) var(--space-xs) var(--space-s) 0;
    border-bottom: 1px dashed var(--rule);
  }

  .metrics dd {
    color: var(--k);
    font-size: var(--step-2);
    font-weight: 520;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-variant-numeric: lining-nums;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .metrics dt {
    color: var(--ink-muted);
    font-size: var(--step--2);
    line-height: 1.4;
  }

  @media (min-width: 52rem) {
    .metrics {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Press strip: a tinted band of quotes across the card. */
  .press {
    grid-area: press;
    display: grid;
    gap: var(--space-s);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  .press-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-s);
  }

  .quote {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-s);
    border-left: 2px solid var(--k);
    background: color-mix(in oklch, var(--wash) 60%, transparent);
  }

  blockquote {
    font-size: var(--step-0);
    font-style: italic;
    line-height: 1.45;
  }

  .social blockquote {
    font-size: var(--step-1);
  }

  .quote figcaption {
    display: grid;
    gap: 0.15em;
    margin-top: auto;
    font-size: var(--step--2);
  }

  .credit {
    line-height: 1.4;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .stats > div {
    display: flex;
    flex-direction: row-reverse;
    gap: 0.4em;
  }

  .stats dd {
    color: var(--ink);
    font-weight: 600;
  }

  .stats dt,
  .stats dd {
    font-size: var(--step--2);
  }

  .note {
    color: color-mix(in oklch, var(--ink) 80%, var(--paper));
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .quote a,
  .links a {
    position: relative;
    z-index: 2;
    color: var(--ink);
    text-decoration-color: var(--rule-strong);
  }

  .quote a:hover,
  .links a:hover {
    color: var(--k);
    text-decoration-color: currentColor;
  }

  .foot {
    grid-area: foot;
    display: grid;
    gap: var(--space-2xs);
  }

  .stack {
    font-size: var(--step--2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    font-size: var(--step--2);
  }
</style>
