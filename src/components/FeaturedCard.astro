---
/** One featured item on the home page: logo, name, role, one sentence, and links. */
import type { Featured } from "../data/featured";
import { withBase } from "../lib/url";

interface Props {
  item: Featured;
}

const { item: f } = Astro.props;
/** The org only shows when the title doesn't already say it. */
const meta = f.org === f.title ? f.role : `${f.org} · ${f.role}`;
---

<li class="feat">
  {f.logo && <img class="logo" src={withBase(f.logo)} alt="" width="16" height="16" />}
  <h3>{f.title}</h3>
  <p class="muted small">{meta}</p>
  <p>{f.hook}</p>
  <p class="small">
    {
      f.links.map((l, i) => (
        <>
          {i > 0 && <span class="muted"> · </span>}
          <a href={l.href}>{l.label}</a>
        </>
      ))
    }
  </p>
</li>

<style>
  /* The logo hangs in the left margin so the text stays on the shared edge. */
  .feat {
    position: relative;
  }

  .logo {
    position: absolute;
    left: -1.75rem;
    top: 0.3em;
    border-radius: 3px;
  }

  @media (max-width: 639.98px) {
    .logo {
      display: none;
    }
  }

  h3 {
    font-weight: 500;
    line-height: inherit;
  }

  .small {
    font-size: var(--step--1);
  }
</style>
