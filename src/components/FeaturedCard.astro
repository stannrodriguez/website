---
/**
 * A large card for the projects at the top of the home page. The corners
 * carry printer's registration marks, which turn when you hover the card.
 */
import { kinds, type Project } from "../data/projects";
import Glyph from "./Glyph.astro";

interface Props {
  project: Project;
  /** 1-based position in the full list; shown as the specimen number. */
  number: number;
}

const { project: p, number } = Astro.props;
const href = p.live ?? p.code;
const no = String(number).padStart(2, "0");
---

<li class={`featured-card kind-${p.kind}`} style={`--i: ${number}`}>
  <span class="mark tl" aria-hidden="true"></span>
  <span class="mark tr" aria-hidden="true"></span>
  <span class="mark bl" aria-hidden="true"></span>
  <span class="mark br" aria-hidden="true"></span>

  <article aria-labelledby={`${p.slug}-featured`}>
    <div class="top meta">
      <span>No. {no}{p.year && ` · ${p.year}`}</span>
      <span class="kind"><span class="dot" aria-hidden="true"></span>{kinds[p.kind].label}</span>
    </div>

    <Glyph slug={p.slug} kind={p.kind} size={72} />

    <h3 id={`${p.slug}-featured`} class="title">
      {href ? <a class="card-link" href={href}>{p.title}</a> : p.title}
      {p.todo && <span class="todo">TODO</span>}
    </h3>

    <p class="summary">{p.summary}</p>
    {p.status && <p class="status meta">{p.status}</p>}

    <div class="foot">
      {p.topics.length > 0 && <p class="topics">{p.topics.join(", ")}</p>}
      {p.stack.length > 0 && <p class="stack meta">{p.stack.join(" · ")}</p>}
      {
        (p.live || p.code) && (
          <p class="links meta">
            {p.live && (
              <a href={p.live}>
                Visit<span aria-hidden="true"> ↗</span>
                <span class="visually-hidden"> {p.title}</span>
              </a>
            )}
            {p.code && (
              <a href={p.code}>
                Code<span aria-hidden="true"> ↗</span>
                <span class="visually-hidden"> for {p.title}</span>
              </a>
            )}
          </p>
        )
      }
    </div>
  </article>
</li>

<style>
  .featured-card {
    position: relative;
    list-style: none;
  }

  /* Registration marks: a small crosshair centered on each corner. */
  .mark {
    position: absolute;
    z-index: 1;
    width: 22px;
    height: 22px;
    margin: -11px;
    background:
      linear-gradient(var(--rule-strong), var(--rule-strong)) center / 100% 1px no-repeat,
      linear-gradient(var(--rule-strong), var(--rule-strong)) center / 1px 100% no-repeat;
    pointer-events: none;
    transition:
      rotate 600ms var(--ease-spring),
      opacity 200ms;
  }

  .tl { top: 0; left: 0; }
  .tr { top: 0; right: 0; }
  .bl { bottom: 0; left: 0; }
  .br { bottom: 0; right: 0; }

  .featured-card:hover .mark,
  .featured-card:focus-within .mark {
    --rule-strong: var(--k);
    rotate: 45deg;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-m);
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    transition: border-color 200ms;
  }

  .featured-card:hover article,
  .featured-card:focus-within article {
    border-color: color-mix(in oklch, var(--k) 45%, var(--rule));
  }

  @media (prefers-reduced-motion: no-preference) {
    .featured-card {
      animation: rise 700ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 70ms + 200ms);
    }

    .featured-card:hover :global(.glyph),
    .featured-card:focus-within :global(.glyph) {
      animation: spin 9s linear infinite;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }

  .top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-xs);
    font-size: var(--step--2);
  }

  .kind {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--k);
  }

  .dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--k);
  }

  .featured-card :global(.glyph) {
    margin-block: var(--space-m) var(--space-s);
  }

  .title {
    font-size: var(--step-2);
    font-weight: 560;
    font-variation-settings: "SOFT" 100, "WONK" 1;
  }

  .card-link {
    text-decoration: none;
  }

  /* The whole card is the title link; the Visit/Code links sit above it. */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .card-link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .card-link:hover {
    color: inherit;
  }

  .summary {
    max-width: 32em;
    color: color-mix(in oklch, var(--ink) 85%, var(--paper));
    line-height: 1.5;
  }

  .status {
    font-size: var(--step--2);
  }

  .foot {
    display: grid;
    gap: var(--space-2xs);
    margin-top: auto;
    padding-top: var(--space-m);
  }

  .topics {
    color: var(--k);
    font-style: italic;
    font-size: var(--step--1);
  }

  .stack {
    font-size: var(--step--2);
  }

  .links {
    display: flex;
    gap: var(--space-s);
    margin-top: var(--space-2xs);
  }

  .links a {
    position: relative;
    z-index: 2;
    color: var(--ink);
    text-decoration-color: var(--rule-strong);
  }

  .links a:hover {
    color: var(--k);
    text-decoration-color: currentColor;
  }
</style>
