---
/** One featured item on the home page: name, role, one sentence, and links. */
import type { Featured } from "../data/featured";

interface Props {
  item: Featured;
}

const { item: f } = Astro.props;
---

<li>
  <h3>{f.title}</h3>
  <p class="muted small">{f.org} · {f.role}</p>
  <p>{f.hook}</p>
  <p class="small">
    {
      f.links.map((l, i) => (
        <>
          {i > 0 && <span class="muted"> · </span>}
          <a href={l.href}>{l.label}</a>
        </>
      ))
    }
  </p>
</li>

<style>
  .small {
    font-size: var(--step--1);
  }
</style>
