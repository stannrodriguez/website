---
/** One featured item on the home page: logo and linked name, then one sentence. */
import type { Featured } from "../data/featured";
import { withBase } from "../lib/url";

interface Props {
  item: Featured;
}

const { item: f } = Astro.props;
---

<li class="feat">
  <h3>
    {f.logo && <img class="logo" src={withBase(f.logo)} alt="" width="16" height="16" />}
    <a href={f.href}>{f.title}</a>
  </h3>
  <p>{f.hook}</p>
</li>

<style>
  /* The logo hangs in the left margin so the text stays on the shared edge. */
  .feat .logo {
    display: inline-block;
    width: 16px;
    height: 16px;
    margin-left: -1.75rem;
    margin-right: calc(1.75rem - 16px);
    vertical-align: -0.15em;
    border-radius: 3px;
  }

  @media (max-width: 639.98px) {
    .logo {
      display: none;
    }
  }

  h3 {
    font-weight: 500;
    line-height: inherit;
  }
</style>
