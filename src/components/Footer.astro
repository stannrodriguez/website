---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer muted">
  <p>© {year} {site.name}</p>
</footer>

<style>
  .site-footer {
    width: 100%;
    max-width: calc(var(--measure) + 2 * var(--space-m));
    margin: auto auto 0;
    padding: var(--space-m);
    font-size: var(--step--1);
  }
</style>
