---
/**
 * Every project as a numbered row, plus kind filters. Without JS every
 * project shows and the filters stay hidden. With JS, filtering animates
 * through the View Transitions API where available and is mirrored in ?kind=
 * so it can be linked.
 */
import { kinds, type Kind, type Project } from "../data/projects";
import ProjectRow from "./ProjectRow.astro";

interface Props {
  projects: Project[];
  /** Number of the first row, so the index can continue after featured cards. */
  start?: number;
}

const { projects, start = 1 } = Astro.props;
const counts = new Map<Kind, number>();
for (const p of projects) counts.set(p.kind, (counts.get(p.kind) ?? 0) + 1);
const present = (Object.keys(kinds) as Kind[]).filter((k) => counts.has(k));
const allBlurb = "Filter by what you'd do with each one.";
---

<div class="index" data-project-index>
  <div class="controls" hidden>
    <div class="filters" role="group" aria-label="Filter projects">
      <button type="button" class="chip" data-filter="all" aria-pressed="true" data-blurb={allBlurb}>
        All <span class="count">{projects.length}</span>
      </button>
      {
        present.map((k) => (
          <button type="button" class={`chip kind-${k}`} data-filter={k} aria-pressed="false" data-blurb={kinds[k].blurb}>
            <span class="dot" aria-hidden="true" />
            {kinds[k].label} <span class="count">{counts.get(k)}</span>
          </button>
        ))
      }
    </div>
    <p class="blurb" aria-live="polite" data-blurb-out>{allBlurb}</p>
  </div>

  <ol class="rows" role="list">
    {projects.map((p, i) => <ProjectRow project={p} number={start + i} />)}
  </ol>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-project-index]")) {
    const controls = root.querySelector<HTMLElement>(".controls");
    const out = root.querySelector<HTMLElement>("[data-blurb-out]");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const rows = [...root.querySelectorAll<HTMLElement>(".row")];
    if (!controls || !out) continue;

    const known = new Set(buttons.map((b) => b.dataset["filter"]));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    const apply = (kind: string) => {
      for (const row of rows) row.hidden = kind !== "all" && row.dataset["kind"] !== kind;
      for (const b of buttons) {
        const on = b.dataset["filter"] === kind;
        b.setAttribute("aria-pressed", String(on));
        if (on) out.textContent = b.dataset["blurb"] ?? "";
      }
    };

    const select = (kind: string) => {
      const url = new URL(location.href);
      if (kind === "all") url.searchParams.delete("kind");
      else url.searchParams.set("kind", kind);
      history.replaceState(null, "", url);

      if (document.startViewTransition && !reduced.matches) document.startViewTransition(() => apply(kind));
      else apply(kind);
    };

    const initial = new URL(location.href).searchParams.get("kind");
    if (initial && known.has(initial)) apply(initial);

    for (const b of buttons) b.addEventListener("click", () => select(b.dataset["filter"] ?? "all"));
    controls.hidden = false;
  }
</script>

<style>
  .controls {
    display: grid;
    gap: var(--space-xs);
    margin-bottom: var(--space-s);
  }

  .controls[hidden] {
    display: none;
  }

  /* A segmented control: one track, the pressed segment raised out of it. */
  .filters {
    display: flex;
    gap: 2px;
    width: fit-content;
    max-width: 100%;
    padding: 3px;
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in oklch, var(--ink) 4%, var(--paper));
    scrollbar-width: none;
  }

  .chip:not([class*="kind-"]) {
    --k: var(--ink);
  }

  .chip {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.45em;
    padding: 0.35em 0.85em;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-muted);
    font: 500 var(--step--2) / 1.3 var(--font-mono);
    cursor: pointer;
    transition:
      color 160ms,
      background-color 160ms,
      border-color 160ms,
      scale 200ms var(--ease-spring);
  }

  .chip:hover {
    color: var(--ink);
  }

  .chip:active {
    scale: 0.95;
  }

  .chip[aria-pressed="true"] {
    border-color: var(--rule);
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: 0 1px 2px color-mix(in oklch, var(--ink) 12%, transparent);
  }

  .dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--k);
  }

  .count {
    opacity: 0.55;
  }

  .blurb {
    padding-left: 0.9em;
    color: var(--ink-muted);
    font-size: var(--step--1);
    font-style: italic;
  }

  .rows {
    padding: 0;
    border-top: 1px solid var(--ink);
  }
</style>
