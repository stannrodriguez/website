---
/**
 * Text whose letters rise in on load and go bold and wonky under the pointer,
 * using Fraunces's weight, softness and wonk axes. Screen readers get the
 * plain string; the per-letter spans are hidden from them.
 */
interface Props {
  text: string;
}

const { text } = Astro.props;
const words = text.split(" ");
let n = 0;
---

<span class="visually-hidden">{text}</span>
<span class="springy" aria-hidden="true">
  {
    words.map((word, w) => (
      <>
        <span class="word">
          {[...word].map((ch) => (
            <span class="ch" style={`--n: ${n++}`}>
              {ch}
            </span>
          ))}
        </span>
        {w < words.length - 1 && " "}
      </>
    ))
  }
</span>

<style>
  .word {
    display: inline-block;
    white-space: nowrap;
  }

  .ch {
    display: inline-block;
    font-variation-settings: "SOFT" 100, "WONK" 0;
    transition:
      font-variation-settings 500ms var(--ease-spring),
      font-weight 500ms var(--ease-spring),
      transform 500ms var(--ease-spring),
      color 300ms;
  }

  .ch:hover {
    color: var(--accent);
    font-weight: 900;
    font-variation-settings: "SOFT" 0, "WONK" 1;
    transform: translateY(-0.06em) rotate(-4deg);
    transition-duration: 160ms;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ch {
      animation: drop 900ms var(--ease-spring) both;
      animation-delay: calc(var(--n) * 38ms + 120ms);
    }
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(0.45em) rotate(6deg);
    }
  }
</style>
