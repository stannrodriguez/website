---
/** One project: title (linked to the live site, else the code), one line, and the year on the right. */
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const href = p.live ?? p.code;
---

<li class="row project">
  <div class="row-text">
    <p>
      {href ? <a href={href}>{p.title}</a> : p.title}
      <span class="muted"> · {p.summary}</span>
      {p.todo && <span class="todo">TODO</span>}
    </p>
    {p.status && <p class="muted small">{p.status}</p>}
    {p.todo && <p class="muted small">{p.todo}</p>}
  </div>
  {p.year && <span class="row-date">{p.year}</span>}
</li>

<style>
  /* The hover wash bleeds past the column; matching padding keeps the text still. */
  .project {
    margin-inline: -0.375rem;
    padding-inline: 0.375rem;
    border-radius: 6px;
    transition: background-color 150ms ease;
  }

  .project:hover {
    background-color: color-mix(in srgb, var(--ink) 4%, transparent);
  }

  .small {
    font-size: var(--step--1);
  }

  a.muted {
    color: var(--ink-muted);
  }
</style>
