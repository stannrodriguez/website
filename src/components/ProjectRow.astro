---
/** One project: title (linked to the live site, else the code), year, and one line. */
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const href = p.live ?? p.code;
---

<li class="project">
  <h3>
    {href ? <a href={href}>{p.title}</a> : p.title}
    {p.year && <span class="muted"> {p.year}</span>}
    {
      p.live && p.code && (
        <span class="muted">
          {" · "}
          <a href={p.code}>
            code<span class="visually-hidden"> for {p.title}</span>
          </a>
        </span>
      )
    }
    {p.todo && <span class="todo">TODO</span>}
  </h3>
  <p>{p.summary}</p>
  {p.status && <p class="muted note">{p.status}</p>}
  {p.todo && <p class="muted note">{p.todo}</p>}
</li>

<style>
  h3 .muted {
    font-weight: 400;
    font-size: var(--step--1);
  }

  .muted a {
    color: inherit;
  }

  .note {
    font-size: var(--step--1);
  }
</style>
