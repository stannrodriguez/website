---
import type { ContactLink } from "../data/site";

interface Props {
  links: ContactLink[];
}

const { links } = Astro.props;
---

<ul role="list">
  {
    links.map((link) => (
      <li>
        <span class="muted">{link.label}</span>{" "}
        {link.href ? <a href={link.href}>{link.handle ?? link.href}</a> : <span class="muted">not added yet</span>}
        {link.todo && (
          <>
            {" "}
            <span class="todo">TODO</span> <span class="note">{link.todo}</span>
          </>
        )}
      </li>
    ))
  }
</ul>

<style>
  li {
    overflow-wrap: anywhere;
  }

  .note {
    color: var(--todo);
    font-size: var(--step--1);
  }
</style>
