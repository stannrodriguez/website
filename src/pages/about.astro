---
import ContactList from "../components/ContactList.astro";
import { career, contact } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";
---

<BaseLayout title="About">
  <h1>About</h1>

  <div class="prose">
    <p>
      I'm a software engineer. Most recently I built AI agents at Assembled. Before that I did a programming retreat at
      the Recurse Center, worked on Core Product at Notion, Prime Gaming at Amazon, and Sonder Social. I studied
      Statistics and Financial Actuarial Math at UCLA and started in finance as a risk and quantitative analyst at
      Capital Group.
    </p>
    <p>
      Outside work, I build small sites and tools to learn whatever I'm curious about. Lately that's systems design,
      physics, the brain, old myths, and words. They're all on the <a href={withBase()}>projects page</a>.
    </p>
    <p>
      My test for technology is simple: it should serve a good purpose, and the people using it should come away better
      for it.
    </p>
  </div>

  <section aria-labelledby="work-heading">
    <h2 id="work-heading">Work</h2>
    <ul role="list">
      {
        career.map((item) => (
          <li>
            {item.org} <span class="muted">· {item.role}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="contact-heading">
    <h2 id="contact-heading">Contact</h2>
    <ContactList links={contact} />
  </section>
</BaseLayout>

<style>
  h1 {
    margin-bottom: var(--space-m);
  }

  .prose > * + * {
    margin-top: var(--space-s);
  }

  section {
    margin-top: var(--space-xl);
  }

  h2 {
    margin-bottom: var(--space-s);
    color: var(--ink-muted);
    font-weight: 400;
  }
</style>
