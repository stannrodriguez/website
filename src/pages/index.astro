---
import FeaturedCard from "../components/FeaturedCard.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { featured } from "../data/featured";
import { projects } from "../data/projects";
import { career, site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

/** Projects that already have a featured entry stay out of the list. */
const inFeatured = new Set(featured.flatMap((f) => (f.project ? [f.project] : [])));
const rest = projects.filter((p) => !inFeatured.has(p.slug));

const orgs = new Intl.ListFormat("en", { type: "conjunction" }).format(career.filter((c) => c.org !== "Recurse Center").map((c) => c.org));
---

<BaseLayout>
  <section class="intro">
    <h1>Hi, I'm Stephanie.</h1>
    <p>I like building tools and being close to the people who use them.</p>
    <p class="muted">{site.role}. Previously at {orgs}.</p>
  </section>

  <section aria-labelledby="featured-heading">
    <h2 id="featured-heading">Featured</h2>
    <ul class="featured" role="list">
      {featured.map((f) => <FeaturedCard item={f} />)}
    </ul>
  </section>

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <ul role="list">
      {rest.map((p) => <ProjectRow project={p} />)}
    </ul>
  </section>
</BaseLayout>

<style>
  section + section {
    margin-top: var(--space-xl);
  }

  .intro {
    display: grid;
    gap: var(--space-s);
  }

  .featured {
    display: grid;
    gap: var(--space-m);
  }
</style>
