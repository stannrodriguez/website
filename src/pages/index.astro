---
import ProjectIndex from "../components/ProjectIndex.astro";
import SpringyText from "../components/SpringyText.astro";
import Ticker from "../components/Ticker.astro";
import { projects } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";

const topics = [...new Set(projects.flatMap((p) => p.topics))];
const years = projects.flatMap((p) => (p.year ? [p.year] : []));
const span = `${Math.min(...years)}–${Math.max(...years)}`;
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    <p class="eyebrow">Software engineer · {projects.length} projects, {span}</p>
    <h1 id="hero-heading"><SpringyText text="Hi, I'm Stephanie." /></h1>
    <p class="lede">
      I build small websites to figure things out: why a spinning ping pong ball curves, what a nanosecond means for a
      system, which Latin roots hide inside English words. Here are some of them.
    </p>
    <p class="meta"><a href={withBase("about/")}>More about me →</a></p>
  </section>

  <Ticker label="Curious about" items={topics} />

  <section class="projects" aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="visually-hidden">Projects</h2>
    <ProjectIndex projects={projects} />
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-xl) var(--space-l);
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 520;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .lede {
    max-width: 34em;
    font-size: var(--step-1);
    line-height: 1.45;
    color: color-mix(in oklch, var(--ink) 82%, var(--paper));
  }

  .projects {
    padding-top: var(--space-l);
  }
</style>
