---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";
---

<BaseLayout title="Page not found" description="This page could not be found." noindex>
  <h1>Page not found</h1>
  <p>This page doesn't exist, or it may have moved. <a href={withBase()}>Go to the home page</a>.</p>
</BaseLayout>

<style>
  h1 {
    margin-bottom: var(--space-s);
  }
</style>
